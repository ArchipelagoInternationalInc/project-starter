{
  "_comment": "Studio Unattended Loop settings. Copy to .claude/settings.json. Edit the allow list to this project's real commands; keep ask and deny lists as written.",
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(npm run *)", "Bash(npm test*)", "Bash(npx vitest*)", "Bash(npx playwright *)", "Bash(npx tsx *)", "Bash(node *)",
      "Bash(npm install *)", "Bash(npm i *)", "Bash(npm ci)",
      "Bash(bash scripts/verify.sh)", "Bash(bash scripts/*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add *)", "Bash(git commit *)", "Bash(git push)", "Bash(git push origin *)", "Bash(git stash*)",
      "Bash(doppler run *)",
      "Bash(ls *)", "Bash(cat *)", "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)"
    ],
    "ask": [
      "Bash(supabase db push*)", "Bash(supabase migration *)", "Bash(supabase link*)",
      "Bash(vercel --prod*)", "Bash(vercel deploy --prod*)", "Bash(vercel env *)",
      "Bash(stripe *)",
      "Bash(doppler secrets *)", "Bash(doppler setup*)",
      "Bash(railway up*)", "Bash(railway variables*)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git rebase *)"
    ],
    "deny": [
      "Bash(rm -rf *)", "Bash(git reset --hard*)", "Bash(git checkout -- .)",
      "Bash(gh auth *)", "Bash(git config user.*)",
      "Bash(curl * | bash*)", "Bash(sudo *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash scripts/verify.sh", "timeout": 1800 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "npm run -s typecheck >/dev/null 2>&1 || echo 'typecheck is failing — fix it before moving on' >&2", "timeout": 180 }
        ]
      }
    ]
  }
}
